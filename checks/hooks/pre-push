#!/bin/sh
# Before any push (J.B., 9 Nov 2026): the published typology spec copies must match Claude Link (checks/tests/spec_sync.js).
# Install once per checkout:  cp checks/hooks/pre-push .git/hooks/pre-push
# A push made from a bundle or another clone without this hook is not checked: run  node checks/tests/spec_sync.js  first.
cd "$(git rev-parse --show-toplevel)" || exit 1
node checks/tests/spec_sync.js || { echo "pre-push: a spec copy differs from Claude Link (see above). Push stopped."; exit 1; }
